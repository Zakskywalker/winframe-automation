{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-winframe",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/WinFrame.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test-winframe",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/WinFrame.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
