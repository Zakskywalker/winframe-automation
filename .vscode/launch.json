{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug WinFrame Studio (WinForms App)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-winframe",
      "program": "${workspaceFolder}/src/WinFrame.App/bin/Debug/net10.0-windows/win-x64/WinFrame.App.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Debug WinFrame CLI (Run Sample Sheet)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-winframe",
      "program": "${workspaceFolder}/src/WinFrame.Cli/bin/Debug/net10.0-windows/win-x64/WinFrame.Cli.exe",
      "args": [
        "run",
        "${workspaceFolder}/samples/highlight_and_inverse_demo.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug WinFrame CLI (Reverse Step Range 6-4)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-winframe",
      "program": "${workspaceFolder}/src/WinFrame.Cli/bin/Debug/net10.0-windows/win-x64/WinFrame.Cli.exe",
      "args": [
        "range",
        "${workspaceFolder}/samples/highlight_and_inverse_demo.csv",
        "6-4"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug WinFrame Remote API Service",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-winframe",
      "program": "${workspaceFolder}/src/WinFrame.Service/bin/Debug/net10.0-windows/win-x64/WinFrame.Service.exe",
      "args": [
        "http://localhost:5880/"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug WinFrame Setup Wizard (Installer)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-winframe",
      "program": "${workspaceFolder}/src/WinFrame.Installer/bin/Debug/net10.0-windows/win-x64/WinFrame.Installer.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}