      },
      {
        "Index": 3,
        "Action": "UIA_INVOKE",
        "Target": "@button_1",
        "Value": "120|220",
        "Options": {
          "retry": "2"
        },
        "Description": "Click button_1 (WinRel: 120,220)"
      },
      {
        "Index": 4,
        "Action": "UIA_INVOKE",
        "Target": "@button_2",
        "Value": "200|220",
        "Options": {
          "retry": "2"
        },
        "Description": "Click button_2 (WinRel: 200,220)"
      },
      {
        "Index": 5,
        "Action": "ASSERT_VAR",
        "Target": "expected",
        "Value": "15",
        "Options": {
          "critical": "true"
        },
        "Description": "Verify expected result variable"
      }
    ]
  },
  {
    "Name": "Checkbox_Toggle_And_Inverse_JSON",
    "TestBed": "Default",
    "Variables": {
      "highlight": "true",
      "mode": "active"
    },
    "Steps": [
      {
        "Index": 1,
        "Action": "SET_VAR",
        "Target": "mode",
