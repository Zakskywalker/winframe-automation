        "Options": {
          "inverse": "UIA_TOGGLE|@checkbox_1|Off"
        },
        "Description": "Toggle checkbox_1 On (inverse automatically toggles Off)"
      },
      {
        "Index": 3,
        "Action": "LOG",
        "Target": "JSON Suite",
        "Value": "Completed Checkbox_Toggle_And_Inverse_JSON in mode=${mode}",
        "Options": {},
