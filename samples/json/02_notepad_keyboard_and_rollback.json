{
  "Name": "Notepad_Keyboard_Entry_And_Inverse_JSON",
  "TestBed": "Notepad",
  "Variables": {
    "highlight": "1",
    "author": "Zak Millikin (Zakskywalker M_A.P.)"
  },
  "Steps": [
    {
      "Index": 1,
      "Action": "AUT",
      "Target": "notepad.exe",
      "Value": "",
      "Options": {},
      "Description": "Reserved: Set Application Under Test (AUT) location directly in test"
    },
    {
      "Index": 2,
      "Action": "COMMAND",
      "Target": "",
      "Value": "self_healing, highlight=\"1\", video=\"external store from config loc\"",
      "Options": {},
      "Description": "Reserved: Comma-separated command list for app config & test attributes"
    },
    {
      "Index": 3,
      "Action": "RA",
      "Target": "",
      "Value": "1",
      "Options": {},
      "Description": "Reserved: Reuse App (RA) at beginning of test"
    },
    {
      "Index": 4,
      "Action": "KAO",
      "Target": "",
      "Value": "1",
      "Options": {},
      "Description": "Reserved: Keep App Open (KAO) between tests"
    },
    {
      "Index": 5,
      "Action": "SET_VAR",
      "Target": "session_status",
      "Value": "typing",
      "Options": {},
      "Description": "Initialize session_status variable"
    },
    {
      "Index": 6,
      "Action": "HIGHLIGHT",
      "Target": "@edit_1",
      "Value": "#A855F7|260|3",
      "Options": {},
      "Description": "Outline @edit_1 with purple Win32 GDI pen"
    },
    {
      "Index": 7,
      "Action": "TYPE",
      "Target": "@edit_1",
      "Value": "Hand of Glory Games and Software — Author: ${author}",
      "Options": {
        "retry": "1"
      },
      "Description": "Type text into @edit_1 (Rule-based inverse: CLEAR_TEXT)"
    },
    {
      "Index": 8,
      "Action": "SEND_KEYS",
      "Target": "@edit_1",
      "Value": "{ENTER}",
      "Options": {},
      "Description": "Commit line with Enter key"
    },
    {
      "Index": 9,
      "Action": "SET_VAR",
      "Target": "session_status",
      "Value": "committed",
      "Options": {},
      "Description": "Mark session as committed"
    },
    {
      "Index": 10,
      "Action": "ASSERT_VAR",
      "Target": "session_status",
      "Value": "committed",
      "Options": {
        "critical": "true"
      },
      "Description": "Verify session_status is committed"
    }
  ]
}
