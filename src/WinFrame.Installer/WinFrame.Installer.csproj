<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>WinFrame.Installer</AssemblyName>
    <RootNamespace>WinFrame.Installer</RootNamespace>
    <Description>WinFrame Automation Studio — Windows 11 Setup Wizard (Hand of Glory Games and Software)</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InstallerPayloadZip Condition="'$(InstallerPayloadZip)' == ''">..\..\installer\WinFramePayload.zip</InstallerPayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" Condition="Exists('..\..\LICENSE')" />
    <EmbeddedResource Include="..\..\assets\splash.jpg" LogicalName="splash.jpg" Condition="Exists('..\..\assets\splash.jpg')" />
    <EmbeddedResource Include="$(InstallerPayloadZip)" LogicalName="WinFramePayload.zip" Condition="Exists('$(InstallerPayloadZip)')" />
  </ItemGroup>

</Project>
